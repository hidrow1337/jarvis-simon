# Where the local voice-service (Hearing and Speaking) listens. It runs in WSL2;
# see voice_service/. Without it, voice is off and typed chat still works.
# The service reads this too and listens on its port.
JARVIS_VOICE_URL=http://127.0.0.1:8731
# The voice-service refuses to start without CUDA. Set to 1 to allow the (slow) CPU.
JARVIS_VOICE_ALLOW_CPU=0
# Jarvis's Kokoro Voice: an English one (af_*, am_*, bf_*, bm_*). bm_george is
# British male; bm_lewis, bm_daniel and bm_fable are others.
JARVIS_VOICE=bm_george

# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=1
